POSTGRES_PASSWORD=replace-with-a-random-database-password
ADMIN_TOKEN=replace-with-a-random-admin-token
MCP_TOKEN=replace-with-a-different-random-mcp-token
MCP_AUTH_MODE=bearer
SESSION_SECRET=replace-with-a-third-random-session-secret

# Keep the service loopback-only unless it is protected by a private LAN/VPN.
BIND_ADDRESS=127.0.0.1
BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TRUSTED_HOSTS=localhost,127.0.0.1
SECURE_COOKIES=false
LOG_LEVEL=INFO

# For a ChatGPT OAuth plugin deployment, set:
# MCP_AUTH_MODE=oauth
# BASE_URL=https://legalagentmcp.ramitshivansh.com
# OAUTH_ISSUER=https://your-tenant.auth0.com/
# OAUTH_AUDIENCE=https://legalagentmcp.ramitshivansh.com/mcp
# OAUTH_REQUIRED_SCOPES=matters:read documents:read evidence:search citations:read
# OAUTH_JWKS_URL=
